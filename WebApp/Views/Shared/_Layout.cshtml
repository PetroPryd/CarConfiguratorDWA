<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Car Configurator</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    Car Configurator
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navMenu">
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <!-- ADMIN navigation -->
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="CarComponent" asp-action="Index">Components</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ComponentType" asp-action="Index">Component Types</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="CarModel" asp-action="Index">Car Models</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Users" asp-action="Index">Users</a>
                            </li>
                        </ul>
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- USER navigation -->
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Browse</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Configuration" asp-action="Build">My Build</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Configuration" asp-action="Index">My Configurations</a>
                            </li>
                        </ul>
                    }

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <span class="navbar-text me-2">@User.Identity!.Name</span>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm me-2">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm ms-2 me-2" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 flex-fill">
        @RenderBody()
    </main>

    <footer class="border-top text-center text-muted py-3 mt-auto">
        <div class="container">
            &copy; @DateTime.Now.Year — Car Configurator
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
