@model WebApp.ViewModels.Configurations.BuildViewModel
@{
    ViewData["Title"] = "My Build";
}

<h2 class="mb-3">My Build</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Info"] != null)
{
    <div class="alert alert-info">@TempData["Info"]</div>
}

<!-- Chosen car (carried from the gallery). If none, let the user pick one here. -->
<div class="card shadow-sm mb-3">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        @if (Model.HasModel)
        {
            <div>
                <small class="text-muted d-block">Configuring</small>
                <span class="fs-5 fw-bold">@Model.SelectedModelName</span>
                <span class="text-muted">· base @Model.SelectedModelBasePrice?.ToString("C")</span>
            </div>
            <form asp-action="SelectModel" method="post" class="d-flex gap-2 align-items-center">
                <select name="carModelId" class="form-select form-select-sm" asp-items="Model.CarModels"></select>
                <button class="btn btn-sm btn-outline-secondary">Change car</button>
            </form>
        }
        else
        {
            <div>
                <small class="text-muted d-block">No car chosen yet</small>
                <span class="fs-6">Pick the car you want to configure:</span>
            </div>
            <form asp-action="SelectModel" method="post" class="d-flex gap-2 align-items-center">
                <select name="carModelId" class="form-select form-select-sm" asp-items="Model.CarModels">
                    <option value="">-- Choose a car --</option>
                </select>
                <button class="btn btn-sm btn-primary">Choose</button>
            </form>
        }
    </div>
</div>

@if (!Model.Components.Any())
{
    <div class="alert alert-info">
        Your build has no components yet.
        <a asp-controller="Catalog" asp-action="Index">Browse components</a> to add some.
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-7">
            <div class="card shadow-sm mb-3">
                <table class="table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Component</th>
                            <th>Type</th>
                            <th class="text-end">Price</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Components)
                        {
                            <tr>
                                <td>@c.Name</td>
                                <td>@c.ComponentTypeName</td>
                                <td class="text-end">@c.Price.ToString("C")</td>
                                <td class="text-end">
                                    <form asp-action="Remove" asp-route-id="@c.Id" method="post" class="d-inline">
                                        <button class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        @if (Model.HasModel)
                        {
                            <tr>
                                <td colspan="2">@Model.SelectedModelName (base)</td>
                                <td class="text-end">@Model.SelectedModelBasePrice?.ToString("C")</td>
                                <td></td>
                            </tr>
                        }
                        <tr>
                            <td colspan="2">Components subtotal</td>
                            <td class="text-end">@Model.ComponentsSubtotal.ToString("C")</td>
                            <td></td>
                        </tr>
                        <tr class="fw-bold">
                            <td colspan="2">Estimated total</td>
                            <td class="text-end">@Model.EstimatedTotal.ToString("C")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <form asp-action="Clear" method="post">
                <button class="btn btn-outline-secondary btn-sm">Clear build</button>
            </form>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Save this configuration</h5>

                    @if (!Model.HasModel)
                    {
                        <div class="alert alert-warning py-2">Choose a car above before saving.</div>
                    }

                    <form asp-action="Save" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <div class="mb-3">
                            <label asp-for="Save.Name" class="form-label"></label>
                            <input asp-for="Save.Name" class="form-control" />
                            <span asp-validation-for="Save.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Save.Notes" class="form-label"></label>
                            <textarea asp-for="Save.Notes" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Save.Notes" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100" disabled="@(!Model.HasModel)">
                            Save configuration
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
