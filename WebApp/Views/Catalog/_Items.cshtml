@model WebApp.ViewModels.CarComponents.CarComponentListViewModel
@{
    // Numbered-pager window: show up to 5 page numbers centred on the current page.
    int total = Model.TotalPages == 0 ? 1 : Model.TotalPages;
    const int windowSize = 5;
    int start = Math.Max(1, Model.Page - windowSize / 2);
    int end = Math.Min(total, start + windowSize - 1);
    start = Math.Max(1, end - windowSize + 1);
}

@if (!Model.Items.Any())
{
    <div class="alert alert-info">No components match your search.</div>
}

<div class="row g-4">
    @foreach (var item in Model.Items)
    {
        <div class="col-md-4">
            <div class="card catalog-card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" class="card-img-top"
                         style="height:180px; object-fit:cover;" alt="@item.Name" />
                }
                else
                {
                    <div class="img-placeholder" style="height:180px;">
                        <span>No image</span>
                    </div>
                }
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-light align-self-start mb-2">@item.ComponentTypeName</span>
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text fw-bold text-primary">@item.Price.ToString("C")</p>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary mt-auto">
                        View Details
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<nav class="mt-4 d-flex justify-content-between align-items-center">
    <span class="text-muted">@Model.TotalCount items · page @Model.Page of @total</span>
    <ul class="pagination mb-0">
        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
            <a class="page-link page-btn" href="#" data-page="@(Model.Page - 1)">&laquo;</a>
        </li>
        @for (int p = start; p <= end; p++)
        {
            <li class="page-item @(p == Model.Page ? "active" : "")">
                <a class="page-link page-btn" href="#" data-page="@p">@p</a>
            </li>
        }
        <li class="page-item @(Model.HasNext ? "" : "disabled")">
            <a class="page-link page-btn" href="#" data-page="@(Model.Page + 1)">&raquo;</a>
        </li>
    </ul>
</nav>
