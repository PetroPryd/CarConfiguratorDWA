@model WebApp.ViewModels.CarComponents.CarComponentListViewModel
@{
    ViewData["Title"] = "Components";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Car Components</h2>
    <a asp-action="Create" class="btn btn-success">+ Add Component</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text" name="search" value="@Model.Search" class="form-control"
               placeholder="Search by name or description..." />
    </div>
    <div class="col-md-4">
        <select name="componentTypeId" class="form-select" asp-items="Model.ComponentTypes">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Reset</a>
    </div>
</form>

<div class="card shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th class="text-end">Price</th>
                <th class="text-center">Stock</th>
                <th class="text-center">Available</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No components found.</td></tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.ComponentTypeName</td>
                    <td class="text-end">@item.Price.ToString("C")</td>
                    <td class="text-center">@item.StockQuantity</td>
                    <td class="text-center">
                        @if (item.IsAvailable)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted">
        Page @Model.Page of @(Model.TotalPages == 0 ? 1 : Model.TotalPages) — @Model.TotalCount items
    </span>
    <div>
        <a class="btn btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")"
           asp-action="Index" asp-route-search="@Model.Search"
           asp-route-componentTypeId="@Model.ComponentTypeId" asp-route-page="@(Model.Page - 1)">
            &laquo; Previous
        </a>
        <a class="btn btn-outline-secondary @(Model.HasNext ? "" : "disabled")"
           asp-action="Index" asp-route-search="@Model.Search"
           asp-route-componentTypeId="@Model.ComponentTypeId" asp-route-page="@(Model.Page + 1)">
            Next &raquo;
        </a>
    </div>
</div>
