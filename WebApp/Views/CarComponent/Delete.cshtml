@model WebApp.ViewModels.CarComponents.CarComponentViewModel
@{
    ViewData["Title"] = "Delete Component";
}

<h2 class="mb-4 text-danger">Delete Component</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
        <dl class="row mb-4">
            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.ComponentTypeName</dd>
            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">@Model.Price.ToString("C")</dd>
            <dt class="col-sm-3">Stock</dt>
            <dd class="col-sm-9">@Model.StockQuantity</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
