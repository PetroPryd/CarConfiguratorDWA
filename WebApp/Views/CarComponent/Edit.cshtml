@model WebApp.ViewModels.CarComponents.CarComponentFormViewModel
@{
    ViewData["Title"] = "Edit Component";
}

<h2 class="mb-4">Edit Component</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <partial name="_FormFields" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Make jQuery client-side validation accept a comma decimal separator (e.g. 10,00).
        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s.]\d{3})+)(?:,\d+)?$/.test(value)
                || /^-?(?:\d+|\d{1,3}(?:[\s,]\d{3})+)(?:\.\d+)?$/.test(value);
        };
        // Range validation also parses numbers — make it comma-friendly too.
        $.validator.methods.range = function (value, element, param) {
            var v = parseFloat(value.replace(",", "."));
            return this.optional(element) || (v >= param[0] && v <= param[1]);
        };
    </script>
}