@model WebApp.ViewModels.Users.UserConfigurationsViewModel
@{
    ViewData["Title"] = $"{Model.User.Username}'s configurations";
}

<a asp-action="Index" class="btn btn-link mb-3 px-0">&laquo; Back to users</a>

<h2 class="mb-1">@Model.User.Name</h2>
<p class="text-muted">@@@Model.User.Username · @Model.User.Email</p>

@if (!Model.Configurations.Any())
{
    <div class="alert alert-info">This user has no saved configurations.</div>
}
else
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Car model</th>
                    <th class="text-center">Components</th>
                    <th class="text-end">Total</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Configurations)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@c.CarModelName</td>
                        <td class="text-center">@c.ComponentCount</td>
                        <td class="text-end">@c.TotalPrice.ToString("C")</td>
                        <td>@c.CreatedAt.ToString("g")</td>
                        <td class="text-end">
                            <a asp-action="ConfigurationDetails" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
