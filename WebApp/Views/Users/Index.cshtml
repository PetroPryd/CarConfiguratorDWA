@model List<WebApp.ViewModels.Users.UserSummaryViewModel>
@{
    ViewData["Title"] = "Users";
}

<h2 class="mb-3">Registered Users</h2>

<div class="card shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Username</th>
                <th>Name</th>
                <th>Email</th>
                <th class="text-center">Role</th>
                <th class="text-center">Configurations</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No users.</td></tr>
            }
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Username</td>
                    <td>@u.Name</td>
                    <td>@u.Email</td>
                    <td class="text-center">
                        @if (u.Role == "Admin")
                        {
                            <span class="badge bg-primary">Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">User</span>
                        }
                    </td>
                    <td class="text-center">@u.ConfigurationCount</td>
                    <td class="text-end">
                        @if (u.Role != "Admin")
                        {
                            <a asp-action="Configurations" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">
                                View configurations
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">&mdash;</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
