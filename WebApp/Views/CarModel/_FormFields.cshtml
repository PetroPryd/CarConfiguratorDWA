@model WebApp.ViewModels.CarModels.CarModelFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input type="hidden" asp-for="Id" />

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Manufacturer" class="form-label"></label>
        <input asp-for="Manufacturer" class="form-control" />
        <span asp-validation-for="Manufacturer" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="BasePrice" class="form-label"></label>
        <input asp-for="BasePrice" class="form-control" />
        <span asp-validation-for="BasePrice" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" class="form-control" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="ImageUrl" class="form-label"></label>
    <input asp-for="ImageUrl" class="form-control" placeholder="https://...  (or upload a file below)" />
    <span asp-validation-for="ImageUrl" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="ImageFile" class="form-label"></label>
    <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" />
    <span asp-validation-for="ImageFile" class="text-danger"></span>

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="mt-2">
            <small class="text-muted d-block">Current image:</small>
            <img src="@Model.ImageUrl" style="height:90px; object-fit:cover;" class="rounded mt-1" alt="current image" />
        </div>
    }
</div>
