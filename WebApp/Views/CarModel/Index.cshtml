@model List<WebApp.ViewModels.CarModels.CarModelViewModel>
@{
    ViewData["Title"] = "Car Models";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Car Models</h2>
    <a asp-action="Create" class="btn btn-success">+ Add Model</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Manufacturer</th>
                <th class="text-center">Year</th>
                <th class="text-end">Base price</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No car models yet.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Manufacturer</td>
                    <td class="text-center">@item.Year</td>
                    <td class="text-end">@item.BasePrice.ToString("C")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
