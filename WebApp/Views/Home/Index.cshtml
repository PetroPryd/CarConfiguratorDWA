@model List<WebApp.ViewModels.CarModels.CarModelViewModel>
@{
    ViewData["Title"] = "Configure";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="text-center mb-4">
    <h1 class="display-4 fw-bold">CONFIGURE</h1>
    <p class="text-muted mb-2">Choose your next build</p>
    <hr class="neon-divider w-25 mx-auto" />
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No car models available yet.</div>
}
else
{
    <div class="row g-4">
        <!-- Model list -->
        <div class="col-md-4">
            <div class="gallery-list">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var m = Model[i];
                    <div class="model-item @(i == 0 ? "active" : "")"
                         data-id="@m.Id"
                         data-name="@m.Manufacturer @m.Name"
                         data-price="@m.BasePrice.ToString("C")"
                         data-img="@m.ImageUrl"
                         data-desc="@m.Description">
                        @m.Manufacturer @m.Name
                    </div>
                }
            </div>
        </div>

        <!-- Hero -->
        <div class="col-md-8">
            <div class="gallery-hero">
                <div id="heroImgWrap"></div>
                <div class="p-4">
                    <h2 id="heroName" class="mb-1"></h2>
                    <p id="heroPrice" class="text-info fs-5 mb-2"></p>
                    <p id="heroDesc" class="text-muted"></p>

                    <div class="mt-3">
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="text-muted">Admins manage the catalogue &mdash; configuring is for customers.</span>
                        }
                        else
                        {
                            <form asp-controller="Configuration" asp-action="Start" method="post">
                                <input type="hidden" name="modelId" id="configureModelId" />
                                <button type="submit" class="btn btn-primary btn-lg px-5">CONFIGURE</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const items = document.querySelectorAll('.model-item');
        const heroImgWrap = document.getElementById('heroImgWrap');
        const heroName = document.getElementById('heroName');
        const heroPrice = document.getElementById('heroPrice');
        const heroDesc = document.getElementById('heroDesc');
        const configureModelId = document.getElementById('configureModelId');

        function selectModel(el) {
            items.forEach(i => i.classList.remove('active'));
            el.classList.add('active');

            const img = el.dataset.img;
            heroImgWrap.innerHTML = img
                ? `<img src="${img}" alt="${el.dataset.name}">`
                : `<div class="no-image">No image</div>`;

            heroName.textContent = el.dataset.name;
            heroPrice.textContent = 'From ' + el.dataset.price;
            heroDesc.textContent = el.dataset.desc || '';
            if (configureModelId) configureModelId.value = el.dataset.id;
        }

        items.forEach(el => el.addEventListener('click', () => selectModel(el)));
        if (items.length) selectModel(items[0]);
    </script>
}
